# Copy this file to .env and fill in your values
# Run: cp .env.example .env && echo "APP_UID=$(id -u)" >> .env && echo "APP_GID=$(id -g)" >> .env

# Docker user mapping (must match your host UID/GID to avoid permission issues with volume mounts)
APP_UID=1000
APP_GID=1000

# Host paths for tool installations (defaults shown)
CODEQL_HOME=~/codeql
CODEQL_LSP_MCP_HOME=~/codeql-lsp-mcp

# Target language for this run — selects the CodeQL qlpack QLCoder uses and
# which CVE metadata CSV it reads (data/project_info.csv for java,
# data/project_info-py.csv for python, data/project_info-js.csv for
# javascript). Defaults to java if left blank.
QLCODER_LANGUAGE=java

# Base directory holding your CodeQL bundle's per-language qlpacks (defaults
# to $CODEQL_HOME/qlpacks/codeql). Combined with QLCODER_LANGUAGE above,
# SECURITY_QLPACK_PATH and LIBRARY_QLPACK_PATH below are auto-derived from
# this — QLCoder finds the installed <version> under
# QLPACK_PATH/<language>-queries/ and QLPACK_PATH/<language>-all/ for you.
QLPACK_PATH=~/codeql/qlpacks/codeql

# Advanced: only set these if your CodeQL install doesn't follow the
# standard QLPACK_PATH/<language>-queries/ + QLPACK_PATH/<language>-all/
# layout above — when set, they override the auto-derived paths.
SECURITY_QLPACK_PATH=
LIBRARY_QLPACK_PATH=

# API Keys
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
GEMINI_API_KEY=
OPENAI_API_KEY=
